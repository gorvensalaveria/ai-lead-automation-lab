OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-nano
APP_ENV=development

# Optional Google Sheets live integration.
# Keep this disabled until you have created a Google Cloud service account,
# enabled the Google Sheets API, and shared the target sheet with the service
# account email.
GOOGLE_SHEETS_ENABLED=false
# Set to true when processed leads should be sent to Google Sheets automatically.
# Duplicate Google Sheets exports are checked by email first, then lead ID.
GOOGLE_SHEETS_AUTO_APPEND=false
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_sheet_id_here
GOOGLE_SHEETS_RANGE=Leads!A:T
GOOGLE_SHEETS_VALUE_INPUT_OPTION=RAW
GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json
# Alternative for hosted deployments:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
