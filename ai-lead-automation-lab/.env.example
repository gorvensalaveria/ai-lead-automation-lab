# App
APP_ENV=development
WORKFLOW_VERSION=lead-intake-v1
SUMMARY_PROMPT_VERSION=summary-v1
CLASSIFICATION_PROMPT_VERSION=classification-v1
FOLLOW_UP_PROMPT_VERSION=follow-up-v1

# OpenAI
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-5.4-nano
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_BASE_SECONDS=1
OPENAI_TIMEOUT_SECONDS=30

# Webhook Security
# Production recommendation: keep auth enabled and use a strong API key.
# The code default is disabled to preserve local browser intake and tests.
WEBHOOK_AUTH_ENABLED=true
WEBHOOK_API_KEYS=replace_with_strong_webhook_key
WEBHOOK_HMAC_ENABLED=false
WEBHOOK_HMAC_SECRET=
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
WEBHOOK_REPLAY_PROTECTION_ENABLED=true

# Google Sheets
# Optional. Enable only after creating a Google Cloud service account,
# enabling the Google Sheets API, and sharing the target sheet with the
# service account email.
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_AUTO_APPEND=false
GOOGLE_SHEETS_SPREADSHEET_ID=replace_with_google_sheet_id
GOOGLE_SHEETS_RANGE=Leads!A:T
GOOGLE_SHEETS_VALUE_INPUT_OPTION=RAW
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
# Alternative for hosted deployments:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace_with_project_id"}

# Airtable
# Optional. Enable only after creating a base, table, and API token.
AIRTABLE_ENABLED=false
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=
AIRTABLE_TIMEOUT_SECONDS=10

# HubSpot
# Optional. Enable only after creating a private app access token.
HUBSPOT_ENABLED=false
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_TIMEOUT_SECONDS=10

# Rate Limiting / Logging
LEAD_PROCESS_RATE_LIMIT_PER_MINUTE=3
LEAD_PROCESS_RATE_LIMIT_WINDOW_SECONDS=60
